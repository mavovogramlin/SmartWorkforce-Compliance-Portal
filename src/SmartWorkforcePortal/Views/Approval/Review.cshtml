@model SmartWorkforcePortal.Models.Request

<h2>Review Request</h2>

<div>
    <p><strong>Employee:</strong> @Model.UserId</p>
    <p><strong>Type:</strong> @Model.RequestType</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Created:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>
</div>

<form asp-action="Review" method="post">
    <input type="hidden" name="id" value="@Model.RequestId" />
    
    <div class="form-group">
        <label>Decision</label>
        <select name="decision" class="form-control" required>
            <option>Approved</option>
            <option>Rejected</option>
        </select>
    </div>

    <div class="form-group">
        <label>Comments</label>
        <textarea name="comments" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success mt-2">Submit</button>
</form>
