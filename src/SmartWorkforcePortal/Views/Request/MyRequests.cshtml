@model IEnumerable<SmartWorkforcePortal.Models.Request>

<h2>My Requests</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Type</th>
            <th>Description</th>
            <th>Status</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.RequestType</td>
            <td>@item.Description</td>
            <td>@item.Status</td>
            <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
        </tr>
    }
    </tbody>
</table>
